#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
args=()
for a in "$@"; do
  case "$a" in
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang)
      # clang 15 and older want this beside -ftrivial-auto-var-init=zero; clang 16 and later refuse it ("unknown argument").
      # xnu-build.sh asks the host's clang once (XNU_CLANG_TAVI_FLAG=1 or 0); asked here when the wrapper is run without it.
      [ -n "${XNU_CLANG_TAVI_FLAG:-}" ] || XNU_CLANG_TAVI_FLAG=$(/usr/bin/clang "$a" -fsyntax-only -x c /dev/null >/dev/null 2>&1 && echo 1 || echo 0)
      if [ "$XNU_CLANG_TAVI_FLAG" = 1 ]; then args+=("$a"); fi ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
exec /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
  -w "${extra[@]}" "${args[@]}"
